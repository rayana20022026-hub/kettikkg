  algorithmVersion    String?  @map("algorithm_version")
  createdAt           DateTime @default(now()) @map("created_at")
  expiresAt           DateTime @map("expires_at")

  trip Trip @relation(fields: [tripId], references: [id])

  @@map("trip_recommendations")
}

model MatchingRequest {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  originCityId    String    @map("origin_city_id")
  destCityId      String    @map("destination_city_id")
  departureDate   DateTime  @map("departure_date")
  passengersCount Int       @map("passengers_count")
  minPrice        Decimal?  @map("min_price")
  maxPrice        Decimal?  @map("max_price")
  /// pending | matched | expired
  status          String    @default("pending")
  expiresAt       DateTime  @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user       User @relation(fields: [userId], references: [id])
  originCity City @relation("MatchingReqOrigin", fields: [originCityId], references: [id])
  destCity   City @relation("MatchingReqDest", fields: [destCityId], references: [id])

  @@map("matching_requests")
}

model Partner {
  id           String  @id @default(uuid())
  name         String
  partnerType  String  @map("partner_type")
  description  String?
  website      String?
  logoMediaId  String? @map("logo_media_id")
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")
  /// active | inactive
  status       String  @default("active")
  createdAt    DateTime @default(now()) @map("created_at")

  offers PartnerOffer[]

  @@map("partners")
}

model PartnerOffer {
  id           String    @id @default(uuid())
  partnerId    String    @map("partner_id")
  title        String
  description  String?
  price        Decimal?
  currencyCode String?   @map("currency_code")
  startsAt     DateTime? @map("starts_at")
  endsAt       DateTime? @map("ends_at")
  /// active | paused | expired
  status       String    @default("active")

  partner Partner @relation(fields: [partnerId], references: [id])

  @@map("partner_offers")
}

model UserFavorite {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  /// trip | partner | route
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, entityType, entityId])
  @@map("user_favorites")
}

